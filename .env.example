# Environment Variables for Salon Management System (Mbarara, Uganda)

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TIMEZONE=Africa/Kampala
NEXT_PUBLIC_DEFAULT_CURRENCY=UGX

# Integration Providers (Placeholders for V1)
PAYMENT_PROVIDER=manual
SMS_PROVIDER=noop
EMAIL_PROVIDER=console
PUSH_PROVIDER=stub
TAX_RECEIPT_PROVIDER=stub

# Review Thresholds & Business Rules
DISCOUNTS_ENABLED=true
DEFAULT_RECEPTIONIST_DISCOUNT_LIMIT_UGX=5000
DEFAULT_RECEPTIONIST_DAILY_DISCOUNT_LIMIT_UGX=25000
APPOINTMENT_GRACE_MINUTES=15
BETWEEN_SERVICES_WARN_MINUTES=10
BETWEEN_SERVICES_ESCALATE_MINUTES=25
WASH_HOLD_LIMIT=2
AUTO_CLOSE_HOUR=23:00
UNDO_CLOSE_MINUTES=15
SUMMARY_DELAY_MINUTES=15

# Demo Simple Login (false in production)
NEXT_PUBLIC_DEMO_SIMPLE_LOGIN=false

# Demo Mode & Dynamic Branding
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SALON_NAME='Mzuri Unisex Salon'
NEXT_PUBLIC_BRANCH_NAME='Mbarara'
